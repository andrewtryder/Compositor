# Build output
dist/
build/
DerivedData/
*.xcarchive
*.dmg

# Xcode per-user state
xcuserdata/
*.xcuserstate

# macOS
.DS_Store

# Signing material and secrets — never commit
*.p12
*.p8
*.cer
*.certSigningRequest
.env

# Claude Code settings personal to this machine
.claude/settings.local.json
BUILD_PLAN.md

# Local HDR plans and agent handoffs: HDR_FULL_PLAN.md, HDR_EDITING_PLAN.md, HDR_LIGHT_PLAN.md
/HDR_*.md

# Local depth-model plan, and the results it brings back (models, depth maps, reports)
/DEPTH_MODEL_PLAN.md
/depth-model-results/

# Test fixtures (large binaries, not committed)
Tests/TestFixtures/
/regression-build.log
/regression-test.log

# Local development evidence: research reports, rendered comparisons, UI screenshots,
# xcresult bundles, benchmarks and scratch scripts. Kept on the machine, never sent
# upstream. Automated tests read only `originals/` (already ignored inside it) and skip
# when it is absent, so a fresh checkout needs none of this.
/work/

# Xcode result bundles and test-run artifacts outside work/
*.xcresult
/TestResults/
/coverage/

# Transient logs from local builds and test runs
*.log

